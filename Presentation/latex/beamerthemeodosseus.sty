% =====================================================================
%  Odosseus Beamer theme — a LaTeX copy of ../odysseus-presentation.html
%  Compile with LuaLaTeX (fontspec):  latexmk  (see latexmkrc)
%
%  Units: the HTML deck is 1600 x 900 px; this deck is 160 x 90 mm,
%  so 1 px = 0.1 mm. Sizes below are the HTML's px values, written as
%  e.g. 58\px, and font sizes as \pxfont{<px>}{<line height>}.
% =====================================================================
\ProvidesPackage{beamerthemeodosseus}

\RequirePackage{fontspec}
\RequirePackage{tikz}
\usetikzlibrary{svg.path,calc,backgrounds}
\RequirePackage{graphicx}
\RequirePackage{etoolbox}

% ---------------------------------------------------------------------
%  THEME — change colors here (same names as the HTML :root variables)
% ---------------------------------------------------------------------
\definecolor{ink}{HTML}{0E1B33}      % deep navy, main dark (logo color)
\definecolor{ink2}{HTML}{1A2E52}
\definecolor{signal}{HTML}{FF5B3A}   % signal orange
\definecolor{amber}{HTML}{FFB627}
\definecolor{sea}{HTML}{3CC8E0}      % sea blue
\definecolor{paper}{HTML}{FFFFFF}
\definecolor{mist}{HTML}{EEF2F7}
\definecolor{line}{HTML}{D6DEEA}
\definecolor{muted}{HTML}{5B6B85}
\definecolor{text}{HTML}{14213A}
% shades used by single elements
\definecolor{bodytext}{HTML}{33425E}    % step / failure paragraphs
\definecolor{cardtext}{HTML}{2A3854}    % card bullet text
\definecolor{footertext}{HTML}{C9D3E4}
\definecolor{hltext}{HTML}{D7DEEA}      % text on the dark (highlighted) step
\definecolor{hlnum}{HTML}{8FA0BE}
\definecolor{insighttext}{HTML}{E6ECF5}
\definecolor{fixtext}{HTML}{1B8FA3}
\definecolor{newbg}{HTML}{E6F7FA}       % "new" step background
\definecolor{introblue}{HTML}{00214E}    % Constructor blue of the INTRO slides (summary slide)

% ---------------------------------------------------------------------
%  Fonts (TTF files in ./fonts, from Google Fonts / Fontsource, OFL)
% ---------------------------------------------------------------------
\newcommand\odfontopts{Path=./fonts/, Extension=.ttf}
\setsansfont{inter}[Path=./fonts/, Extension=.ttf, UprightFont=*-400, BoldFont=*-700]
\newfontfamily\intermedium{inter-500}[Path=./fonts/, Extension=.ttf, BoldFont=inter-700]
\newfontfamily\intersemibold{inter-600}[Path=./fonts/, Extension=.ttf, BoldFont=inter-700]
\newfontfamily\interbold{inter-700}[Path=./fonts/, Extension=.ttf]
\newfontfamily\headfont{space-grotesk-700}[Path=./fonts/, Extension=.ttf]   % titles
\newfontfamily\brandfont{outfit-600}[Path=./fonts/, Extension=.ttf]         % logo wordmark
\renewcommand\familydefault{\sfdefault}

% ---------------------------------------------------------------------
%  Units and sizes
% ---------------------------------------------------------------------
\newlength\px \setlength\px{0.1mm}
% \pxfont{<size px>}{<line height factor>}: CSS "font: <size>px/<lh>"
\newcommand\pxfont[2]{\fontsize{\fpeval{#1*0.284528}}{\fpeval{#1*#2*0.284528}}\selectfont}
\newcommand\tracking[1]{\addfontfeature{LetterSpace=#1}}   % CSS letter-spacing, in % of the font size

\newlength\contentwidth \setlength\contentwidth{1408\px}  % 1600 - 2 x 96
\newcommand\footertext{Camera-based localization · National AI Hackathon 2026}

% ---------------------------------------------------------------------
%  Beamer setup
% ---------------------------------------------------------------------
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=96\px, text margin right=96\px}
\setbeamercolor{normal text}{fg=text, bg=paper}
\setbeamertemplate{headline}{}
\setbeamertemplate{footline}{}

% ---------------------------------------------------------------------
%  The logo (ship with eye sail): \odlogo{<width>}{<ship color>}{<eye cut-out color>}
% ---------------------------------------------------------------------
